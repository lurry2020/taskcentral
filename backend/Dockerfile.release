FROM python:3.12-slim

ARG TASKCENTRAL_VERSION=1.1.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TASKCENTRAL_VERSION=${TASKCENTRAL_VERSION}

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY backend/entrypoint.sh ./entrypoint.sh
COPY MANUAL.md ./MANUAL.md
COPY CHANGELOG.md ./CHANGELOG.md

RUN mkdir -p /data /backups /logs \
    && chmod 755 /app/entrypoint.sh

ENV DATA_DIR=/data \
    DATABASE_URL=sqlite:////data/taskcentral.db \
    LOG_DIR=/logs \
    CHANGELOG_PATH=/app/CHANGELOG.md

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)" || exit 1

CMD ["/app/entrypoint.sh"]
