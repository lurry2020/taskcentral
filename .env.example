# Task Central configuration
# Copy to .env and adjust. All variables have sensible defaults.

# Display name shown in the UI header (also editable in Settings)
APP_NAME=Task Central

# Environment label: development | production
APP_ENV=production

# Runtime version used to select the matching CHANGELOG.md section.
# Published release bundles set this automatically.
TASKCENTRAL_VERSION=1.1.3

# GitHub repository used by the in-app version check and release updater.
TASKCENTRAL_RELEASE_REPOSITORY=lurry2020/taskcentral

# Host port the app is published on (http://localhost:8484)
APP_PORT=8484

# Database connection string.
# SQLite default (file stored in the ./data volume):
DATABASE_URL=sqlite:////data/taskcentral.db
# PostgreSQL example (install psycopg first, see README):
# DATABASE_URL=postgresql+psycopg://taskcentral:secret@db:5432/taskcentral

# Comma-separated origins allowed for CORS. Only needed when the frontend is
# served from a different origin than the API (e.g. dev server on :5173).
CORS_ORIGINS=http://localhost:8484

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Persistent files are stored under ./logs. Each file rotates at this size
# and keeps this many older copies.
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Signs browser sessions. Always use a unique random value in production.
SECRET_KEY=change-me-to-something-random

# Data directory inside the backend container (bind-mounted to ./data)
DATA_DIR=/data

# Set to true to seed a few sample machines on first start (tagged #sample-data)
DEMO_MODE=false

# Legacy/CLI login fallback. The first-run setup wizard stores its own username
# and password hash in the database, which take precedence over these values.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-on-first-run
# How long a login session stays valid before requiring sign-in again (hours).
AUTH_TOKEN_TTL_HOURS=168
